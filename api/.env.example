PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NODE_ENV=development
# Default: local in development, s3 in production. Never falls back on AWS errors.
STORAGE_DRIVER=local
# Relative to api/ (or an absolute path). Keep uploaded files outside Git.
LOCAL_UPLOAD_DIR=uploads
CORS_ORIGIN=http://localhost:5173

AWS_REGION=us-east-2
AWS_S3_BUCKET=mi0-assets-prod
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Solo para crear/actualizar el superadmin inicial
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Alan
SUPERADMIN_LAST_NAME=Burga

# Publicación de Sorteos Avanzado: S/4.90, verificación manual
YAPE_PHONE=
YAPE_NAME=

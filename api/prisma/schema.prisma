generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum WorkspaceStatus {
  ACTIVE
  INACTIVE
}

enum WorkspaceType {
  PERSONAL
  ORGANIZATION
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @db.VarChar(80)
  lastName     String       @map("last_name") @db.VarChar(120)
  email        String       @unique @db.VarChar(254)
  passwordHash String       @map("password_hash") @db.VarChar(255)
  role         String       @default("USER") @db.VarChar(40)
  status       UserStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  sessions     Session[]
  raffles      Raffle[]
  publicationRequests RafflePublication[] @relation("PublicationRequester")
  publicationReviews RafflePublication[] @relation("PublicationReviewer")
  memberships Membership[]
  citaAccesses CitaProfessionalAccess[]
  turnOperators TurnOperator[]
  turnCalls TurnTicket[] @relation("TurnCalledBy")
  dashboardRequests TurnDashboardPayment[] @relation("DashboardRequester")
  dashboardReviews TurnDashboardPayment[] @relation("DashboardReviewer")
  bingoRooms BingoRoom[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  userId     String    @map("user_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Workspace {
  linkRequests CatalogLinkRequest[]
  publicAddresses WorkspacePublicAddress[]
  publicSlug String? @unique @db.VarChar(80)
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @db.VarChar(120)
  type        WorkspaceType   @default(ORGANIZATION)
  status      WorkspaceStatus @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  memberships Membership[]

  modules     WorkspaceModule[]
  raffles     Raffle[]
  turnQueue   TurnQueue?
  citaClinic  CitaClinic?
  qrCatalog QrCatalog?
  catalogProducts CatalogProduct[]
  catalogCategories CatalogCategory[]
  bingoRooms BingoRoom[]

  @@map("workspaces")
}

model Membership {
  userId      String         @map("user_id") @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  role        MembershipRole @default(MEMBER)
  createdAt   DateTime       @default(now()) @map("created_at")
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

model Module {
  id          String            @id @default(uuid()) @db.Uuid
  code        String            @unique @db.VarChar(60)
  name        String            @db.VarChar(100)
  description String?           @db.VarChar(300)
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  workspaces  WorkspaceModule[]
  categories  Category[]
  free        Boolean @default(false)
  iconKey     String? @db.VarChar(200)
  details     String @default("") @db.Text
  features    String[] @default([])
  screenshots ModuleScreenshot[]

  @@map("modules")
}

model WorkspaceModule {
  workspaceId String    @map("workspace_id") @db.Uuid
  moduleId    String    @map("module_id") @db.Uuid
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  module      Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([workspaceId, moduleId])
  @@index([moduleId])
  @@map("workspace_modules")
}

enum RaffleStatus {
  DRAFT
  COMPLETED
}

enum RafflePublicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Raffle {
  id            String       @id @default(uuid()) @db.Uuid
  workspaceId   String       @map("workspace_id") @db.Uuid
  createdById   String       @map("created_by_id") @db.Uuid
  name          String       @db.VarChar(120)
  status        RaffleStatus @default(DRAFT)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  drawnAt       DateTime?    @map("drawn_at")
  publicCode    String?      @unique @map("public_code") @db.VarChar(32)
  publishedAt   DateTime?    @map("published_at")
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy     User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  participants  RaffleParticipant[]
  prizes        RafflePrize[]
  results       RaffleResult[]
  publications  RafflePublication[]

  @@index([workspaceId, createdAt])
  @@map("raffles")
}

model RaffleParticipant {
  id        String @id @default(uuid()) @db.Uuid
  raffleId  String @map("raffle_id") @db.Uuid
  name      String @db.VarChar(120)
  order     Int
  raffle    Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  results   RaffleResult[]

  @@unique([raffleId, id])
  @@unique([raffleId, order])
  @@map("raffle_participants")
}

model RafflePrize {
  id        String @id @default(uuid()) @db.Uuid
  raffleId  String @map("raffle_id") @db.Uuid
  name      String @db.VarChar(120)
  order     Int
  raffle    Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  results   RaffleResult[]

  @@unique([raffleId, id])
  @@unique([raffleId, order])
  @@map("raffle_prizes")
}

model RaffleResult {
  id            String @id @default(uuid()) @db.Uuid
  raffleId      String @map("raffle_id") @db.Uuid
  prizeId       String @map("prize_id") @db.Uuid
  participantId String @map("participant_id") @db.Uuid
  drawnAt       DateTime @map("drawn_at")
  raffle        Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  prize         RafflePrize @relation(fields: [raffleId, prizeId], references: [raffleId, id], onDelete: Restrict)
  participant   RaffleParticipant @relation(fields: [raffleId, participantId], references: [raffleId, id], onDelete: Restrict)

  @@unique([raffleId, prizeId])
  @@unique([raffleId, participantId])
  @@map("raffle_results")
}

model RafflePublication {
  id              String @id @default(uuid()) @db.Uuid
  raffleId        String @map("raffle_id") @db.Uuid
  requestedById   String @map("requested_by_id") @db.Uuid
  reviewedById    String? @map("reviewed_by_id") @db.Uuid
  reference       String @unique @db.VarChar(40)
  amountCents     Int @default(490) @map("amount_cents")
  status          RafflePublicationStatus @default(PENDING)
  requestedAt     DateTime @default(now()) @map("requested_at")
  reviewedAt      DateTime? @map("reviewed_at")
  rejectionReason String? @map("rejection_reason") @db.VarChar(300)
  raffle          Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  requestedBy     User @relation("PublicationRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy      User? @relation("PublicationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([status, requestedAt])
  @@index([raffleId, requestedAt])
  @@map("raffle_publications")
}

model TurnQueue {
  dashboardUntil DateTime?
  dashboardPayments TurnDashboardPayment[]
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @unique @db.Uuid
  code        String @unique @db.VarChar(16)
  name        String @db.VarChar(120)
  lastNumber  Int @default(0)
  documentMode String @default("NONE") @db.VarChar(16)
  counterNames Json @default("[\"Ventanilla 1\"]")
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tickets     TurnTicket[]
  operators   TurnOperator[]
  invitations TurnInvitation[]
}

model TurnTicket {
  id        String @id @default(uuid()) @db.Uuid
  queueId   String @db.Uuid
  number    Int
  name      String @db.VarChar(80)
  clientKey String @db.VarChar(80)
  documentType String? @db.VarChar(8)
  documentNumber String? @db.VarChar(20)
  status    String @default("WAITING") @db.VarChar(16)
  counter   Int?
  createdAt DateTime @default(now())
  calledAt  DateTime?
  calledById String? @db.Uuid
  calledBy User? @relation("TurnCalledBy", fields: [calledById], references: [id], onDelete: SetNull)
  endedAt   DateTime?
  servedAt  DateTime?
  queue     TurnQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)
  @@unique([queueId, number])
  @@index([queueId, status, number])
  @@index([queueId, clientKey, status])
  @@index([queueId, createdAt])
}

model TurnOperator {
  id        String @id @default(uuid()) @db.Uuid
  queueId   String @db.Uuid
  userId    String @db.Uuid
  counter   Int
  createdAt DateTime @default(now())
  queue     TurnQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([queueId, userId])
  @@index([queueId, counter])
}

model TurnInvitation {
  id         String @id @default(uuid()) @db.Uuid
  queueId    String @db.Uuid
  email      String @db.VarChar(254)
  counter    Int
  tokenHash  String @unique @db.Char(64)
  status     String @default("PENDING") @db.VarChar(16)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  acceptedAt DateTime?
  queue      TurnQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)
  @@unique([queueId, email])
}


model TurnDashboardPayment {
  id String @id @default(uuid()) @db.Uuid
  queueId String @db.Uuid
  requestedById String @db.Uuid
  reviewedById String? @db.Uuid
  plan String @db.VarChar(16)
  amountCents Int
  reference String @unique @db.VarChar(80)
  status String @default("PENDING") @db.VarChar(16)
  requestedAt DateTime @default(now())
  reviewedAt DateTime?
  rejectionReason String? @db.VarChar(300)
  validFrom DateTime?
  validUntil DateTime?
  queue TurnQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)
  requestedBy User @relation("DashboardRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("DashboardReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  @@index([queueId, requestedAt])
  @@index([status, requestedAt])
}

enum CitaStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

model CitaClinic {
  id                String @id @default(uuid()) @db.Uuid
  workspaceId       String @unique @map("workspace_id") @db.Uuid
  code              String @unique @db.VarChar(24)
  name              String @db.VarChar(120)
  timezone          String @default("America/Lima") @db.VarChar(64)
  requireDni        Boolean @default(false) @map("require_dni")
  expirationHours   Int? @map("expiration_hours")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accesses          CitaProfessionalAccess[]
  invitations       CitaInvitation[]
  professionals     CitaProfessional[]
  appointments      CitaAppointment[]

  @@map("cita_clinics")
}

model CitaProfessional {
  id              String @id @default(uuid()) @db.Uuid
  clinicId        String @map("clinic_id") @db.Uuid
  name            String @db.VarChar(120)
  specialty       String @db.VarChar(120)
  durationMinutes Int @default(30) @map("duration_minutes")
  active          Boolean @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  clinic          CitaClinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  accesses        CitaProfessionalAccess[]
  invitations     CitaInvitation[]
  schedules       CitaSchedule[]
  appointments    CitaAppointment[]

  @@unique([clinicId, id])
  @@index([clinicId, active])
  @@map("cita_professionals")
}

model CitaSchedule {
  id             String @id @default(uuid()) @db.Uuid
  professionalId String @map("professional_id") @db.Uuid
  weekday        Int
  startMinute    Int @map("start_minute")
  endMinute      Int @map("end_minute")
  professional   CitaProfessional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, weekday, startMinute])
  @@map("cita_schedules")
}

model CitaAppointment {
  id             String @id @default(uuid()) @db.Uuid
  clinicId       String @map("clinic_id") @db.Uuid
  professionalId String @map("professional_id") @db.Uuid
  requestKey     String @unique @map("request_key") @db.Uuid
  patientName    String @map("patient_name") @db.VarChar(120)
  phone          String @db.VarChar(16)
  dni            String? @db.VarChar(8)
  startsAt       DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime @map("ends_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  status         CitaStatus @default(PENDING)
  createdAt      DateTime @default(now()) @map("created_at")
  confirmedAt    DateTime? @map("confirmed_at")
  cancelledAt    DateTime? @map("cancelled_at")
  expiredAt      DateTime? @map("expired_at")
  clinic         CitaClinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  professional   CitaProfessional @relation(fields: [clinicId, professionalId], references: [clinicId, id], onDelete: Restrict)

  @@index([clinicId, startsAt])
  @@index([status, expiresAt])
  @@map("cita_appointments")
}

model CitaProfessionalAccess {
  id             String @id @default(uuid()) @db.Uuid
  clinicId       String @map("clinic_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  professionalId String @map("professional_id") @db.Uuid
  active         Boolean @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  clinic         CitaClinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  professional   CitaProfessional @relation(fields: [clinicId, professionalId], references: [clinicId, id], onDelete: Cascade)
  @@unique([clinicId, userId])
  @@map("cita_professional_accesses")
}
model CitaInvitation {
  id             String @id @default(uuid()) @db.Uuid
  clinicId       String @map("clinic_id") @db.Uuid
  professionalId String @map("professional_id") @db.Uuid
  email          String @db.VarChar(254)
  tokenHash      String @unique @map("token_hash") @db.Char(64)
  status         String @default("PENDING") @db.VarChar(16)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at")
  acceptedAt     DateTime? @map("accepted_at")
  clinic         CitaClinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  professional   CitaProfessional @relation(fields: [clinicId, professionalId], references: [clinicId, id], onDelete: Cascade)
  @@unique([clinicId, email])
  @@index([professionalId, status])
  @@map("cita_invitations")
}

model Category {
  id String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(80)
  modules Module[]
  @@map("categories")
}

model ModuleScreenshot {
  id String @id @default(uuid()) @db.Uuid
  moduleId String @map("module_id") @db.Uuid
  storageKey String @map("storage_key") @db.VarChar(200)
  contentType String @map("content_type") @db.VarChar(40)
  caption String @db.VarChar(180)
  position Int @default(0)
  published Boolean @default(true)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  @@index([moduleId, position])
  @@map("module_screenshots")
}


// Products belong to the workspace, independently of the QR presentation.
model QrCatalog {
  bannerKey String?
  bannerType String?
  linkLocked Boolean @default(false)
  presentation String @default("CATALOG") @db.VarChar(10)
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @unique @db.Uuid
  code String @unique @db.VarChar(24)
  name String @db.VarChar(120)
  description String @default("") @db.VarChar(500)
  currency String @default("PEN") @db.VarChar(3)
  whatsapp String @default("") @db.VarChar(15)
  socialLinks Json @default("[]")
  published Boolean @default(false)
  plan String @default("FREE") @db.VarChar(10)
  logoKey String?
  logoType String?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@map("qr_catalogs")
}
model CatalogCategory {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  name String @db.VarChar(80)
  position Int @default(0)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  products CatalogProduct[]
  @@unique([workspaceId, id])
  @@map("catalog_categories")
}
model CatalogProduct {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  categoryId String? @db.Uuid
  name String @db.VarChar(120)
  description String @default("") @db.VarChar(1000)
  priceCents Int
  position Int @default(0)
  status String @default("AVAILABLE") @db.VarChar(20)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category CatalogCategory? @relation(fields: [workspaceId, categoryId], references: [workspaceId, id], onDelete: NoAction)
  images CatalogProductImage[]
  @@index([workspaceId, position])
  @@map("catalog_products")
}
model CatalogProductImage {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  storageKey String
  contentType String
  position Int @default(0)
  product CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, position])
  @@map("catalog_product_images")
}


model WorkspacePublicAddress {
  slug String @id @db.VarChar(80)
  workspaceId String @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId])
  @@map("workspace_public_addresses")
}

model CatalogLinkRequest {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  requestedById String @db.Uuid
  requestedSlug String @db.VarChar(60)
  reason String @db.VarChar(300)
  status String @default("PENDING") @db.VarChar(10)
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  reviewedById String? @db.Uuid
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
  @@map("catalog_link_requests")
}

model BingoRoom {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  ownerId String @db.Uuid
  code String @unique @db.VarChar(32)
  name String @db.VarChar(120)
  status String @default("WAITING") @db.VarChar(16)
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  participants BingoParticipant[]
  rounds BingoRound[]
  @@index([workspaceId, createdAt])
  @@map("bingo_rooms")
}

model BingoParticipant {
  id String @id @default(uuid()) @db.Uuid
  roomId String @db.Uuid
  name String @db.VarChar(80)
  tokenHash String @db.Char(64)
  card Int[]
  cardKey String @db.VarChar(100)
  createdAt DateTime @default(now())
  room BingoRoom @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([roomId, tokenHash])
  @@unique([roomId, cardKey])
  @@map("bingo_participants")
}

model BingoRound {
  id String @id @default(uuid()) @db.Uuid
  roomId String @db.Uuid
  number Int
  pattern String @db.VarChar(8)
  prize String @default("") @db.VarChar(120)
  status String @default("ACTIVE") @db.VarChar(16)
  balls Int[] @default([])
  winners Json @default("[]")
  createdAt DateTime @default(now())
  closedAt DateTime?
  room BingoRoom @relation(fields: [roomId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([roomId, number])
  @@map("bingo_rounds")
}
